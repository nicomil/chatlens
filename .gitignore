# API keys. They now live in this machine's configuration directory, but a
# workspace may still keep its own file, and a checkout is often used as one.
.env

# Data. Inputs are experiment exports with participant identifiers and chat
# text; outputs derive from them. They stay local, always.
input/
output/

# Somebody else's source tree. Both clone into this machine's application data
# directory by default, so neither is normally here at all — these entries are
# for the case where `--repo .` was passed, or a clone was made by hand. They
# are large, they are not ours, and a clone inside a working copy is one
# `git add -A` away from being committed.
relatio/
topicGPT/

# Virtual environments and build artefacts. A full relatio install is about
# 1.6 GB of torch and transformers; it lives in an environment, never in here.
.venv/
.venv-*/
dist/
build/
*.egg-info/

__pycache__/
*.py[cod]

# The built site: generated by mkdocs, never committed.
site/

# The guide's PDF is a build artefact — `python scripts/tutorial/pdf.py`
# remakes it in seconds — and when its figures are shot on a real study it
# carries what participants wrote to one another. That does not belong in a
# repository, least of all one meant to be published.
chatlens-guide.pdf
chatlens-guide.html
